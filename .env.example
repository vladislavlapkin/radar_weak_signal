# Weak Signals — env template
POSTGRES_USER=signals
# на демо-стенде замените пароль базы
POSTGRES_PASSWORD=signals_pwd
POSTGRES_DB=weak_signals
DATABASE_URL=postgresql+psycopg2://signals:signals_pwd@localhost:5433/weak_signals

# YandexGPT (основной). Выдаются по запросу.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_LITE_MODEL=yandexgpt-lite/latest
YANDEX_PRO_MODEL=yandexgpt/rc

# GigaChat (fallback)
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Режим без ключей: LLM работает как экстрактивный суммаризатор (для офлайн-демо)
LLM_OFFLINE_OK=true
